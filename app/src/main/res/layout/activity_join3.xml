<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageButton
        android:id="@+id/previous_button"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:layout_marginTop="25dp"
        android:layout_marginStart="20dp"
        android:scaleType="centerInside"
        android:background="@android:color/transparent"
        android:src="@drawable/left_arrow"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <FrameLayout
        android:id="@+id/progress_bar_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="85dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_percent="0.8" />



    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:fontFamily="@font/notosans_kr_medium"
        android:textSize="18sp"
        android:includeFontPadding="false"
        android:text="회원가입"
        app:layout_constraintTop_toBottomOf="@id/progress_bar_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/description"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:paddingLeft="4dp"
        android:fontFamily="@font/notosans_kr_regular"
        android:textSize="16sp"
        android:includeFontPadding="false"
        android:text="본인 인증할 이메일을 입력하세요."
        app:layout_constraintTop_toBottomOf="@id/title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <LinearLayout
        android:id="@+id/email_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="71dp"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/description"
        app:layout_constraintWidth_percent="0.8">

        <EditText
            android:id="@+id/email_input"
            android:layout_width="0dp"
            android:layout_height="55dp"
            android:layout_weight="1"
            android:background="@drawable/edit_text_style"
            android:contentDescription="Id input field"
            android:inputType="text"/>

        <View
            android:layout_width="7dp"
            android:layout_height="0dp" />

        <android.widget.Button
            android:id="@+id/check_button"
            android:layout_width="78dp"
            android:layout_height="55dp"
            android:layout_gravity="right"
            android:padding="0dp"
            android:background="@drawable/edit_text_style"
            android:fontFamily="@font/notosans_kr_regular"
            android:textSize="16sp"
            android:includeFontPadding="false"
            android:text="전송" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/check_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="25dp"
        android:visibility="invisible"
        app:layout_constraintTop_toBottomOf="@id/email_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_percent="0.8">

        <TextView
            android:id="@+id/check_description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingLeft="4dp"
            android:fontFamily="@font/notosans_kr_regular"
            android:textSize="15sp"
            android:textColor="#929292"
            android:includeFontPadding="false"
            android:text="입력하신 메일로 인증 번호를 발송하였습니다." />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="5dp"
            android:background="@drawable/edit_text_style2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintWidth_percent="0.8">

            <EditText
                android:id="@+id/check_number"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:inputType="number"
                android:textSize="16sp"
                android:hint="인증번호 입력"
                android:background="@android:color/transparent"
                android:contentDescription="check number input field"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/timer"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

            <TextView
                android:id="@+id/timer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="03:00"
                android:textColor="#FF4E4E"
                android:textSize="16sp"
                app:layout_constraintStart_toEndOf="@id/check_number"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>

    <android.widget.Button
        android:id="@+id/nextButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="50dp"
        android:background="@drawable/button_black_color"
        android:fontFamily="@font/notosans_kr_medium"
        android:includeFontPadding="false"
        android:paddingVertical="17dp"
        android:text="다음"
        android:textColor="@color/white"
        android:textSize="18sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_percent="0.8" />

</androidx.constraintlayout.widget.ConstraintLayout>

