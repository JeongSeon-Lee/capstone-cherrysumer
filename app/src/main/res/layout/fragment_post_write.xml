<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/post_write"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingVertical="15dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/notosans_kr_medium"
            android:includeFontPadding="false"
            android:text="게시글 작성"
            android:textColor="#000000"
            android:textSize="18sp" />

    </LinearLayout>

    <View
        android:id="@+id/under_line1"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="#EBEBEB"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/post_write"/>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/under_line1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_percent="0.9">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="25dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal" >

                <LinearLayout
                    android:id="@+id/image_select_icon"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:background="@drawable/image_select_border">

                        <ImageView
                            android:layout_width="25dp"
                            android:layout_height="25dp"
                            android:scaleType="centerInside"
                            android:background="@android:color/transparent"
                            android:src="@drawable/ic_camera" />

                        <TextView
                            android:id="@+id/image_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/notosans_kr_medium"
                            android:includeFontPadding="false"
                            android:text="0/3"
                            android:textColor="@color/cherry"
                            android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/image_container"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="20dp"
                    android:orientation="horizontal">

                </LinearLayout>

            </LinearLayout>

            <!-- 제목 입력 필드 -->
            <LinearLayout
                android:id="@+id/title_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/description"
                app:layout_constraintWidth_percent="0.8">

                <TextView
                    android:id="@+id/title_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/notosans_kr_medium"
                    android:includeFontPadding="false"
                    android:paddingLeft="4dp"
                    android:layout_marginBottom="3dp"
                    android:text="제목"
                    android:textSize="15sp" />

                <EditText
                    android:id="@+id/title_input"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:background="@drawable/edit_text_style3"
                    android:contentDescription="title input field"
                    android:inputType="text" />
            </LinearLayout>

            <!-- 상품명 입력 필드 -->
            <LinearLayout
                android:id="@+id/item_name_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/description"
                app:layout_constraintWidth_percent="0.8">

                <TextView
                    android:id="@+id/item_name_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/notosans_kr_medium"
                    android:includeFontPadding="false"
                    android:paddingLeft="4dp"
                    android:layout_marginBottom="3dp"
                    android:text="상품명"
                    android:textSize="15sp" />

                <EditText
                    android:id="@+id/item_name_input"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:background="@drawable/edit_text_style3"
                    android:contentDescription="item name input field"
                    android:inputType="text" />
            </LinearLayout>

            <!-- 단위 가격 입력 필드 -->
            <LinearLayout
                android:id="@+id/unit_price_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/description"
                app:layout_constraintWidth_percent="0.8">

                <TextView
                    android:id="@+id/unit_price_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/notosans_kr_medium"
                    android:includeFontPadding="false"
                    android:paddingLeft="4dp"
                    android:text="단위 가격"
                    android:textSize="15sp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/price_container"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:orientation="vertical"
                        android:layout_weight="6"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/description">

                        <TextView
                            android:id="@+id/price_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/notosans_kr_medium"
                            android:includeFontPadding="false"
                            android:paddingLeft="4dp"
                            android:layout_marginBottom="3dp"
                            android:text="총 가격"
                            android:textSize="13sp"
                            android:textColor="#9E9E9E"/>

                        <EditText
                            android:id="@+id/price_input"
                            android:layout_width="match_parent"
                            android:layout_height="55dp"
                            android:background="@drawable/edit_text_style3"
                            android:contentDescription="price input field"
                            android:inputType="text" />
                    </LinearLayout>

                    <View
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1" />

                    <LinearLayout
                        android:id="@+id/personnel_container"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:orientation="vertical"
                        android:layout_weight="6"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/description">

                        <TextView
                            android:id="@+id/personnel_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/notosans_kr_medium"
                            android:includeFontPadding="false"
                            android:paddingLeft="4dp"
                            android:layout_marginBottom="3dp"
                            android:text="모집 인원 (나 포함)"
                            android:textSize="13sp"
                            android:textColor="#9E9E9E"/>

                        <EditText
                            android:id="@+id/personnel_input"
                            android:layout_width="match_parent"
                            android:layout_height="55dp"
                            android:background="@drawable/edit_text_style3"
                            android:contentDescription="personnel input field"
                            android:inputType="text" />
                    </LinearLayout>

                </LinearLayout>

                <TextView
                    android:id="@+id/price_per_person"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/notosans_kr_medium"
                    android:includeFontPadding="false"
                    android:paddingLeft="4dp"
                    android:layout_marginBottom="3dp"
                    android:text="1인당 부담 가격 : "
                    android:textSize="13sp"
                    android:textColor="#9E9E9E"/>
            </LinearLayout>

            <!-- 만남 날짜 입력 필드 -->
            <LinearLayout
                android:id="@+id/date_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/description"
                app:layout_constraintWidth_percent="0.8">

                <TextView
                    android:id="@+id/date_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/notosans_kr_medium"
                    android:includeFontPadding="false"
                    android:paddingLeft="4dp"
                    android:layout_marginBottom="3dp"
                    android:text="만남 날짜"
                    android:textSize="15sp" />

                <EditText
                    android:id="@+id/date_input"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:background="@drawable/edit_text_style3"
                    android:contentDescription="date input field"
                    android:inputType="none"
                    android:hint="YYYY-MM-DD"/>
            </LinearLayout>

            <!-- 만남 시간 입력 필드 -->
            <LinearLayout
                android:id="@+id/time_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/description"
                app:layout_constraintWidth_percent="0.8">

                <TextView
                    android:id="@+id/time_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/notosans_kr_medium"
                    android:includeFontPadding="false"
                    android:paddingLeft="4dp"
                    android:layout_marginBottom="3dp"
                    android:text="만남 시간"
                    android:textSize="15sp" />

                <EditText
                    android:id="@+id/time_input"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:background="@drawable/edit_text_style3"
                    android:contentDescription="date input field"
                    android:inputType="none"
                    android:hint="HH:MM"/>
            </LinearLayout>

            <!-- 만남 장소 입력 필드 -->
            <LinearLayout
                android:id="@+id/place_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/description"
                app:layout_constraintWidth_percent="0.8">

                <TextView
                    android:id="@+id/place_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/notosans_kr_medium"
                    android:includeFontPadding="false"
                    android:paddingLeft="4dp"
                    android:layout_marginBottom="3dp"
                    android:text="만남 장소"
                    android:textSize="15sp" />

                <EditText
                    android:id="@+id/place_input"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:background="@drawable/edit_text_style3"
                    android:contentDescription="date input field"
                    android:inputType="text" />
            </LinearLayout>

            <!-- 카테고리 입력 필드 -->
            <LinearLayout
                android:id="@+id/category_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/description"
                app:layout_constraintWidth_percent="0.8">

                <TextView
                    android:id="@+id/category_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/notosans_kr_medium"
                    android:includeFontPadding="false"
                    android:paddingLeft="4dp"
                    android:layout_marginBottom="3dp"
                    android:text="카테고리"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/basic_category_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/notosans_kr_medium"
                    android:includeFontPadding="false"
                    android:paddingLeft="4dp"
                    android:layout_marginBottom="3dp"
                    android:text="기본 카테고리를 선택하세요."
                    android:textSize="13sp" />

                <HorizontalScrollView
                    android:id="@+id/basic_category_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:scrollbars="none"
                    app:layout_constraintTop_toBottomOf="@id/description_container"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintWidth_percent="0.9">

                    <LinearLayout
                        android:id="@+id/category_box"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" >

                        <TextView
                            android:id="@+id/fruit_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/notosans_kr_medium"
                            android:includeFontPadding="false"
                            android:paddingVertical="8dp"
                            android:paddingHorizontal="20dp"
                            android:layout_marginBottom="3dp"
                            android:layout_marginRight="8dp"
                            android:text="과일"
                            android:textSize="14sp"
                            android:background="@drawable/post_category_select_button"/>

                        <TextView
                            android:id="@+id/vegetable_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/notosans_kr_medium"
                            android:includeFontPadding="false"
                            android:paddingVertical="8dp"
                            android:paddingHorizontal="20dp"
                            android:layout_marginBottom="3dp"
                            android:layout_marginRight="8dp"
                            android:text="채소"
                            android:textSize="14sp"
                            android:background="@drawable/post_category_select_button"/>

                        <TextView
                            android:id="@+id/dairy_products_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/notosans_kr_medium"
                            android:includeFontPadding="false"
                            android:paddingVertical="8dp"
                            android:paddingHorizontal="20dp"
                            android:layout_marginBottom="3dp"
                            android:layout_marginRight="8dp"
                            android:text="유제품"
                            android:textSize="14sp"
                            android:background="@drawable/post_category_select_button"/>

                        <TextView
                            android:id="@+id/meat_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/notosans_kr_medium"
                            android:includeFontPadding="false"
                            android:paddingVertical="8dp"
                            android:paddingHorizontal="20dp"
                            android:layout_marginBottom="3dp"
                            android:layout_marginRight="8dp"
                            android:text="정육"
                            android:textSize="14sp"
                            android:background="@drawable/post_category_select_button"/>

                        <TextView
                            android:id="@+id/frozen_food_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/notosans_kr_medium"
                            android:includeFontPadding="false"
                            android:paddingVertical="8dp"
                            android:paddingHorizontal="20dp"
                            android:layout_marginBottom="3dp"
                            android:layout_marginRight="8dp"
                            android:text="냉동식품"
                            android:textSize="14sp"
                            android:background="@drawable/post_category_select_button"/>

                        <TextView
                            android:id="@+id/marine_products_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/notosans_kr_medium"
                            android:includeFontPadding="false"
                            android:paddingVertical="8dp"
                            android:paddingHorizontal="20dp"
                            android:layout_marginBottom="3dp"
                            android:layout_marginRight="8dp"
                            android:text="수산물"
                            android:textSize="14sp"
                            android:background="@drawable/post_category_select_button"/>

                        <TextView
                            android:id="@+id/drink_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/notosans_kr_medium"
                            android:includeFontPadding="false"
                            android:paddingVertical="8dp"
                            android:paddingHorizontal="20dp"
                            android:layout_marginBottom="3dp"
                            android:layout_marginRight="8dp"
                            android:text="음료"
                            android:textSize="14sp"
                            android:background="@drawable/post_category_select_button"/>

                        <TextView
                            android:id="@+id/convenient_food_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/notosans_kr_medium"
                            android:includeFontPadding="false"
                            android:paddingVertical="8dp"
                            android:paddingHorizontal="20dp"
                            android:layout_marginBottom="3dp"
                            android:layout_marginRight="8dp"
                            android:text="간편식"
                            android:textSize="14sp"
                            android:background="@drawable/post_category_select_button"/>

                        <TextView
                            android:id="@+id/desert_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/notosans_kr_medium"
                            android:includeFontPadding="false"
                            android:paddingVertical="8dp"
                            android:paddingHorizontal="20dp"
                            android:layout_marginBottom="3dp"
                            android:layout_marginRight="8dp"
                            android:text="디저트"
                            android:textSize="14sp"
                            android:background="@drawable/post_category_select_button"/>

                        <TextView
                            android:id="@+id/delivery_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/notosans_kr_medium"
                            android:includeFontPadding="false"
                            android:paddingVertical="8dp"
                            android:paddingHorizontal="20dp"
                            android:layout_marginBottom="3dp"
                            android:layout_marginRight="8dp"
                            android:text="배달"
                            android:textSize="14sp"
                            android:background="@drawable/post_category_select_button"/>

                        <TextView
                            android:id="@+id/daily_supplies_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/notosans_kr_medium"
                            android:includeFontPadding="false"
                            android:paddingVertical="8dp"
                            android:paddingHorizontal="20dp"
                            android:layout_marginBottom="3dp"
                            android:layout_marginRight="8dp"
                            android:text="생활용품"
                            android:textSize="14sp"
                            android:background="@drawable/post_category_select_button"/>
                    </LinearLayout>
                </HorizontalScrollView>

                <TextView
                    android:id="@+id/detail_category_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/notosans_kr_medium"
                    android:includeFontPadding="false"
                    android:layout_marginTop="10dp"
                    android:paddingLeft="4dp"
                    android:layout_marginBottom="3dp"
                    android:text="세부 카테고리를 추가하세요."
                    android:textSize="13sp" />

                <LinearLayout
                    android:id="@+id/category_add_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/category_input"
                        android:layout_width="0dp"
                        android:layout_height="55dp"
                        android:layout_weight="1"
                        android:background="@drawable/edit_text_style3"
                        android:contentDescription="detail category input field"
                        android:inputType="text"/>

                    <View
                        android:layout_width="7dp"
                        android:layout_height="0dp" />

                    <android.widget.Button
                        android:id="@+id/reg_button"
                        android:layout_width="78dp"
                        android:layout_height="55dp"
                        android:layout_gravity="right"
                        android:padding="0dp"
                        android:background="@drawable/edit_text_style3"
                        android:fontFamily="@font/notosans_kr_medium"
                        android:textSize="16sp"
                        android:includeFontPadding="false"
                        android:text="등록" />
                </LinearLayout>

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:scrollbars="none"
                    app:layout_constraintTop_toBottomOf="@id/description_container"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintWidth_percent="0.9">

                    <LinearLayout
                        android:id="@+id/detail_category_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" >

                    </LinearLayout>

                </HorizontalScrollView>

            </LinearLayout>

            <!-- 설명글 입력 필드 -->
            <LinearLayout
                android:id="@+id/description_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/description"
                app:layout_constraintWidth_percent="0.8">

                <TextView
                    android:id="@+id/description_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/notosans_kr_medium"
                    android:includeFontPadding="false"
                    android:paddingLeft="4dp"
                    android:layout_marginBottom="3dp"
                    android:text="설명글"
                    android:textSize="15sp" />

                <EditText
                    android:id="@+id/description_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/edit_text_style3"
                    android:contentDescription="description input field"
                    android:gravity="top|start"
                    android:inputType="textMultiLine"
                    android:scrollHorizontally="false"
                    android:lines="5"
                    android:maxLines="10"
                    android:scrollbars="vertical"
                    android:padding="10dp"/>
            </LinearLayout>

            <android.widget.Button
                android:id="@+id/write_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:paddingVertical="17dp"
                android:background="@drawable/button_pink_color"
                android:fontFamily="@font/notosans_kr_medium"
                android:textSize="18sp"
                android:textColor="#FFFFFF"
                android:includeFontPadding="false"
                android:text="게시하기"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintWidth_percent="0.8"/>
        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>