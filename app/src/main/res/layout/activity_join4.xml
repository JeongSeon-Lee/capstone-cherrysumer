<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 이전 버튼 -->
    <ImageButton
        android:id="@+id/previous_button"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:layout_marginTop="25dp"
        android:layout_marginStart="20dp"
        android:scaleType="centerInside"
        android:background="@android:color/transparent"
        android:src="@drawable/left_arrow"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- 상태바를 포함할 FrameLayout -->
    <FrameLayout
        android:id="@+id/progress_bar_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="85dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_percent="0.8" />

    <!-- 타이틀 텍스트 -->
    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:fontFamily="@font/notosans_kr_medium"
        android:textSize="18sp"
        android:includeFontPadding="false"
        android:text="회원가입"
        app:layout_constraintTop_toBottomOf="@id/progress_bar_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- 설명 텍스트 -->
    <TextView
        android:id="@+id/description"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:paddingBottom="30dp"
        android:paddingLeft="4dp"
        android:fontFamily="@font/notosans_kr_regular"
        android:textSize="16sp"
        android:includeFontPadding="false"
        android:text="관심있는 카테고리를 모두 선택해주세요!"
        app:layout_constraintTop_toBottomOf="@id/title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toTopOf="@id/scroll_view"
        app:layout_constraintEnd_toEndOf="parent"/>

    <ScrollView
        android:id="@+id/scroll_view"
        android:layout_width="282dp"
        android:layout_height="282dp"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/description"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- 카테고리 선택 영역 -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/select_category"
            android:layout_width="282dp"
            android:layout_height="282dp"
            android:layout_gravity="center"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- 첫 번째 줄의 카테고리 -->
            <LinearLayout
                android:id="@+id/items_container1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="100dp"
                android:orientation="horizontal"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <LinearLayout
                    android:id="@+id/item1"
                    android:layout_width="86dp"
                    android:layout_height="86dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/category_background" >

                    <TextView
                        android:id="@+id/item_img1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="32sp"
                        android:text="🍎" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:textSize="14sp"
                        android:text="과일" />

                </LinearLayout>

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1"/>

                <!-- 나머지 아이템들... 동일한 구조 -->
                <LinearLayout
                    android:id="@+id/item2"
                    android:layout_width="86dp"
                    android:layout_height="86dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/category_background">

                    <TextView
                        android:id="@+id/item_img2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="32sp"
                        android:text="🍔" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:textSize="14sp"
                        android:text="배달"
                        tools:ignore="DuplicateIds" />
                </LinearLayout>

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1"/>

                <LinearLayout
                    android:id="@+id/item3"
                    android:layout_width="86dp"
                    android:layout_height="86dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/category_background">

                    <TextView
                        android:id="@+id/item_img3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="32sp"
                        android:text="🍖" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:textSize="14sp"
                        android:text="정육" />
                </LinearLayout>
            </LinearLayout>

            <!-- 두 번째 줄의 카테고리 -->
            <LinearLayout
                android:id="@+id/items_container2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintTop_toBottomOf="@id/items_container1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:id="@+id/item4"
                    android:layout_width="86dp"
                    android:layout_height="86dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/category_background">

                    <TextView
                        android:id="@+id/item_img4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="32sp"
                        android:text="🍨" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:textSize="14sp"
                        android:text="냉동식품" />
                </LinearLayout>

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1"/>

                <!-- 나머지 아이템들... 동일한 구조 -->
                <LinearLayout
                    android:id="@+id/item5"
                    android:layout_width="86dp"
                    android:layout_height="86dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/category_background">

                    <TextView
                        android:id="@+id/item_img5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="32sp"
                        android:text="🎣" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:textSize="14sp"
                        android:text="수산물" />
                </LinearLayout>

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1"/>

                <LinearLayout
                    android:id="@+id/item6"
                    android:layout_width="86dp"
                    android:layout_height="86dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/category_background">

                    <TextView
                        android:id="@+id/item_img6"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="32sp"
                        android:text="🥤" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:textSize="14sp"
                        android:text="음료" />
                </LinearLayout>
            </LinearLayout>

            <!-- 세 번째 줄의 카테고리 -->
            <LinearLayout
                android:id="@+id/items_container3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintTop_toBottomOf="@id/items_container2"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:id="@+id/item7"
                    android:layout_width="86dp"
                    android:layout_height="86dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/category_background">

                    <TextView
                        android:id="@+id/item_img7"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="32sp"
                        android:text="🍜" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:textSize="14sp"
                        android:text="간편식" />
                </LinearLayout>

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1"/>

                <LinearLayout
                    android:id="@+id/item8"
                    android:layout_width="86dp"
                    android:layout_height="86dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/category_background">

                    <TextView
                        android:id="@+id/item_img8"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="32sp"
                        android:text="🥐" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:textSize="14sp"
                        android:text="디저트" />
                </LinearLayout>

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1"/>

                <LinearLayout
                    android:id="@+id/item9"
                    android:layout_width="86dp"
                    android:layout_height="86dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:background="@drawable/category_background">

                    <TextView
                        android:id="@+id/item_img9"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🗑"
                        android:textSize="32sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:text="생활용품"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 네 번째 줄의 카테고리 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintTop_toBottomOf="@id/items_container3"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:id="@+id/item10"
                    android:layout_width="86dp"
                    android:layout_height="86dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/category_background">

                    <TextView
                        android:id="@+id/item_img10"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="32sp"
                        android:text="🍆" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:textSize="14sp"
                        android:text="채소" />
                </LinearLayout>

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1"/>

                <LinearLayout
                    android:id="@+id/item11"
                    android:layout_width="86dp"
                    android:layout_height="86dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/category_background">

                    <TextView
                        android:id="@+id/item_img11"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="32sp"
                        android:text="🥛" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:textSize="14sp"
                        android:text="유제품" />
                </LinearLayout>

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1"/>

                <LinearLayout
                    android:id="@+id/item12"
                    android:layout_width="86dp"
                    android:layout_height="86dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="invisible"
                    android:background="@drawable/category_background">

                    <TextView
                        android:id="@+id/item_img12"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🗑"
                        android:textSize="32sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:text="생활용품"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
    <!-- 다음 버튼 -->
    <android.widget.Button
        android:id="@+id/nextButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="50dp"
        android:background="@drawable/button_black_color"
        android:fontFamily="@font/notosans_kr_medium"
        android:includeFontPadding="false"
        android:paddingVertical="17dp"
        android:text="다음"
        android:textColor="@color/white"
        android:textSize="18sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_percent="0.8" />

</androidx.constraintlayout.widget.ConstraintLayout>