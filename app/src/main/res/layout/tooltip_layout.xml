<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/tooltip_background"
    android:padding="16dp"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:elevation="6dp"
    android:gravity="start">

    <TextView
        android:id="@+id/tooltip_text_d_day"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:lineSpacingExtra="4dp"
        android:textColor="@android:color/black"
        android:text="디데이 : 유통기한까지 남은 날짜를 알려줍니다. 3일 남으면 경고등이 켜집니다." />

    <TextView
        android:id="@+id/tooltip_text_quantity"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:lineSpacingExtra="4dp"
        android:textColor="@android:color/black"
        android:layout_marginTop="8dp"
        android:text="수량 : 해당 상품의 수량을 알려줍니다. 2개 남으면 경고등이 켜집니다." />

    <TextView
        android:id="@+id/tooltip_text_add"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:lineSpacingExtra="4dp"
        android:textColor="@android:color/black"
        android:layout_marginTop="8dp"
        android:text="추가 : 오른쪽 하단의 연필 버튼을 누르면 항목을 추가할 수 있습니다." />

    <TextView
        android:id="@+id/tooltip_text_modify_delete"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:lineSpacingExtra="4dp"
        android:textColor="@android:color/black"
        android:layout_marginTop="8dp"
        android:text="수정‧삭제 : 원하는 항목을 왼쪽으로 슬라이드하면 기능이 보입니다." />
</LinearLayout>
