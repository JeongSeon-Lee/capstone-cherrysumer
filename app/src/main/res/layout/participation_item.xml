<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="90dp"
    android:orientation="horizontal"
    android:paddingHorizontal="5dp"
    android:gravity="center_vertical">

    <ImageView
        android:id="@+id/post_image"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:scaleType="centerCrop"
        android:background="@drawable/round_border_5dp"
        android:src="@drawable/peach"
        android:clipToOutline="true" />

    <LinearLayout
        android:id="@+id/post_description"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:layout_marginStart="8dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/header_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/post_id"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/notosans_kr_regular"
                    android:textSize="16sp"
                    android:includeFontPadding="false"
                    android:text="1"
                    android:visibility="gone"
                    android:textColor="#000000"/>

                <TextView
                    android:id="@+id/title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/notosans_kr_regular"
                    android:textSize="16sp"
                    android:includeFontPadding="false"
                    android:text="복숭아 5팩 같이 사실 분"
                    android:textColor="#000000"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" >

                <TextView
                    android:id="@+id/closed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:layout_marginRight="8dp"
                    android:fontFamily="@font/notosans_kr_bold"
                    android:textSize="12sp"
                    android:includeFontPadding="false"
                    android:text="참여완료"
                    android:background="@drawable/closed_box"
                    android:textColor="#FFFFFF"
                    android:visibility="gone"/>

                <TextView
                    android:id="@+id/status_ment"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:fontFamily="@font/notosans_kr_regular"
                    android:textSize="14sp"
                    android:text="승인 여부 : "
                    android:includeFontPadding="false"
                    android:textColor="#6F6F6F"/>

                <TextView
                    android:id="@+id/status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:layout_marginLeft="3dp"
                    android:fontFamily="@font/notosans_kr_regular"
                    android:textSize="14sp"
                    android:includeFontPadding="false"
                    android:text="승인"
                    android:textColor="#FF5959"/>

            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/register_button"
            android:layout_width="75dp"
            android:layout_height="30dp"
            android:gravity="center"
            android:fontFamily="@font/notosans_kr_medium"
            android:textSize="14sp"
            android:includeFontPadding="false"
            android:text="재고등록"
            android:textColor="#FFFFFF"
            android:background="@drawable/category_box"/>

    </LinearLayout>

</LinearLayout>