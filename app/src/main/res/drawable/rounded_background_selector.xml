<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 선택된 상태 -->
    <item android:state_selected="true">
        <shape>
            <solid android:color="@color/red" /> <!-- 배경색: 빨간색 -->
            <corners android:radius="16dp" /> <!-- 둥근 모서리 -->
            <stroke android:width="0dp" android:color="@android:color/transparent" /> <!-- 테두리 제거 -->
        </shape>
    </item>
    <!-- 비선택 상태 -->
    <item android:state_selected="false">
        <shape>
            <solid android:color="@color/white" /> <!-- 배경색: 흰색 -->
            <corners android:radius="16dp" /> <!-- 둥근 모서리 -->
            <stroke android:width="1dp" android:color="@color/light_gray" /> <!-- 테두리 회색 -->
        </shape>
    </item>
</selector>
